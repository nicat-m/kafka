# ca-root for sign all certificates
# truststore contain only ca-root certificate
# keystore contain ca-root and broker certificates

#!/bin/bash

set -e
########### ENV VARIABLES ###############

dt=`date +%F`
KEY_PASS={{KEY_PASS}}
KEYSTORE_PASS={{KEYSTORE_PASS}}
TURSTSTORE_PASS={{TRUSTSTORE_PASS}}
VALIDITY={{VALIDITY}}
CERT_DIR={{CERT_PATH}}
ORG_UNIT="{{ORG_UNIT}}"
ORG="{{ORG}}"
COMMON_NAME="{{COMMON_NAME}}"
LOCALITY="{{LOCALITY}}"
STATE_PROVINCE="{{STATE_PROVINCE}}"
COUNTRY="{{COUNTRY}}"
CA_CERT="$CERT_DIR/ca.cert"
CA_KEY="$CERT_DIR/ca.key"
###################################

mkdir -p "$CERT_DIR"

create_certs(){

  BROKERS=({% for host in groups['all'] %}"{{ hostvars[host]['ansible_hostname'] }}"{% if not loop.last %} {% endif %}{% endfor %})

  echo "[+] Creating CA-ROOT Certificate..."
  openssl req -new -x509 -keyout "$CA_KEY" -out "$CA_CERT" -days "$VALIDITY" -passout pass:$KEY_PASS -subj "/CN=$COMMON_NAME"

  for broker in "${BROKERS[@]}"; do
    echo "[*] $broker preparing for this broker..."

    # Create config file for SANs (Həm PEM, həm də JKS imzalama zamanı SAN-ları qorumaq üçün)
    cat > "$CERT_DIR/$broker.cnf" <<EOF
[req]
distinguished_name = req_distinguished_name
req_extensions = v3_req
prompt = no

[req_distinguished_name]
C = $COUNTRY
ST = $STATE_PROVINCE
L = $LOCALITY
O = $ORG
OU = $ORG_UNIT
CN = $broker

[v3_req]
keyUsage = digitalSignature, keyEncipherment, dataEncipherment
extendedKeyUsage = serverAuth, clientAuth
subjectAltName = @alt_names

[alt_names]
DNS.1 = $broker
DNS.2 = $COMMON_NAME

# Add more SANs here if needed, e.g. DNS.3 = kafka.service.consul
EOF

{% if SSL_KEYSTORE_TYPE == 'PEM' %}
    # --- PEM YANAŞMASI ---
    # Step 1: Generate Private Key and CSR (PEM format)
    openssl req -new -newkey rsa:2048 -nodes \
      -keyout "$CERT_DIR/$broker.key" \
      -out "$CERT_DIR/$broker.csr" \
      -config "$CERT_DIR/$broker.cnf"

    # Step 2: Sign CSR with CA
    openssl x509 -req \
      -CA "$CA_CERT" \
      -CAkey "$CA_KEY" \
      -in "$CERT_DIR/$broker.csr" \
      -out "$CERT_DIR/$broker-signed.crt" \
      -days "$VALIDITY" \
      -CAcreateserial \
      -passin pass:$KEY_PASS \
      -extensions v3_req \
      -extfile "$CERT_DIR/$broker.cnf"

    # Step 3: Create Combined PEM Keystore (Key + Cert)
    cat "$CERT_DIR/$broker.key" "$CERT_DIR/$broker-signed.crt" > "$CERT_DIR/$broker.pem"

{% else %}
    # --- JKS YANAŞMASI ---
    # Step 1: Creating Keystore and Keypair
    keytool -genkeypair \
      -alias "$broker" \
      -keyalg RSA \
      -keysize 2048 \
      -keystore "$CERT_DIR/$broker.keystore.jks" \
      -storepass "$KEYSTORE_PASS" \
      -keypass "$KEYSTORE_PASS" \
      -validity $VALIDITY \
      -dname "CN=$broker, OU=$ORG_UNIT, O=$ORG, L=$LOCALITY, ST=$STATE_PROVINCE, C=$COUNTRY" \
      -ext "SAN=DNS:$broker,DNS:$COMMON_NAME"

    # Step 2: Creating CSR from Keystore
    keytool -certreq \
      -alias "$broker" \
      -keystore "$CERT_DIR/$broker.keystore.jks" \
      -file "$CERT_DIR/$broker.csr" \
      -storepass "$KEYSTORE_PASS"

    # Step 3: Signing with CA
    openssl x509 -req \
      -CA "$CA_CERT" \
      -CAkey "$CA_KEY" \
      -in "$CERT_DIR/$broker.csr" \
      -out "$CERT_DIR/$broker-signed.crt" \
      -days "$VALIDITY" \
      -CAcreateserial \
      -passin pass:$KEY_PASS \
      -extensions v3_req \
      -extfile "$CERT_DIR/$broker.cnf"

    # Step 4: Import CA Root to Keystore
    keytool -importcert \
      -keystore "$CERT_DIR/$broker.keystore.jks" \
      -alias CARoot \
      -file "$CA_CERT" \
      -storepass "$KEYSTORE_PASS" -noprompt

    # Step 5: Import Signed Broker Cert to Keystore
    keytool -importcert \
      -keystore "$CERT_DIR/$broker.keystore.jks" \
      -alias "$broker" \
      -file "$CERT_DIR/$broker-signed.crt" \
      -storepass "$KEYSTORE_PASS" -noprompt

{% endif %}

    # Clean up config file
    rm "$CERT_DIR/$broker.cnf"

  done

{% if SSL_KEYSTORE_TYPE != 'PEM' %}
    # Step 6: Creating Truststore and import CA
    keytool -importcert \
      -keystore "$CERT_DIR/kafka.truststore.jks" \
      -alias CARoot \
      -file "$CA_CERT" \
      -storepass "$TURSTSTORE_PASS" -noprompt
{% endif %}

  echo ""
  echo "✅ INFO: $dt All Certificate and JKS successfully created !!!"
}

check_cert_files(){
  if [ "$(ls -A $CERT_DIR)" ]; then
    echo "Files exist under $CERT_DIR"
    echo "WARN: $dt Deleting old files..."
    rm -rf $CERT_DIR/*
    sleep 1
    create_certs
  else
    create_certs
  fi
}

check_cert_files
