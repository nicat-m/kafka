process.roles=broker,controller

node.id= {{ node_id }}
KAFKA_CLUSTER_ID={{ KAFKA_CLUSTER_ID }}

controller.quorum.voters={% for host in groups['all'] %}{{ loop.index }}@{{ hostvars[host]['inventory_hostname'] }}:{{ CONTROLLER_PORT }}{% if not loop.last %},{% endif %}{% endfor %}

controller.listener.names=CONTROLLER

socket.send.buffer.bytes=102400
socket.receive.buffer.bytes=102400
socket.request.max.bytes=104857600

num.partitions=12
num.recovery.threads.per.data.dir=1
num.network.threads=3
num.io.threads=8

offsets.topic.replication.factor=2
share.coordinator.state.topic.replication.factor=1
share.coordinator.state.topic.min.isr=1
transaction.state.log.replication.factor=2
transaction.state.log.min.isr=1

log.retention.hours=168
log.segment.bytes=1073741824
log.retention.check.interval.ms=300000
log.dirs={{ KAFKA_LOG_DIR | default('/var/lib/kafka') }}

# ACL
authorizer.class.name=org.apache.kafka.metadata.authorizer.StandardAuthorizer
allow.everyone.if.no.acl.found=false
super.users=User:ANONYMOUS;User:{{SSL_USER_DN}};User:broker

ssl.principal.mapping.rules=RULE:^CN=.*$/broker/,\
    RULE:^CN=([a-zA-Z0-9.\-]*),OU=(broker|admin)$/$2/,\
    RULE:^CN=([a-zA-Z0-9.\-]*),OU=(client)$/$1@$2/,\
    DEFAULT

# Listeners
inter.broker.listener.name=BROKER
listeners=CLIENT://0.0.0.0:{{ CLIENT_PORT }},CONTROLLER://0.0.0.0:{{ CONTROLLER_PORT }},BROKER://0.0.0.0:{{ BROKER_PORT }}
listener.security.protocol.map=CLIENT:SSL,CONTROLLER:SSL,BROKER:SSL
advertised.listeners=BROKER://{{inventory_hostname}}:{{ BROKER_PORT }},CLIENT://{{ inventory_hostname }}:{{ CLIENT_PORT }}

# SSL configuration
ssl.client.auth=required

# SSL Keystore Configuration
ssl.keystore.type={{ SSL_KEYSTORE_TYPE | default('JKS') }}
{% if SSL_KEYSTORE_TYPE == 'PEM' %}
ssl.keystore.location={{ KEYSTORE_PATH }}/{{ansible_hostname}}.pem
{% else %}
ssl.keystore.location={{ KEYSTORE_PATH }}/{{ansible_hostname}}.keystore.jks
ssl.keystore.password={{ KEYSTORE_PASS }}
ssl.key.password={{ KEY_PASS }}
{% endif %}

# SSL Truststore Configuration
ssl.truststore.type={{ SSL_TRUSTSTORE_TYPE | default('JKS') }}
{% if SSL_TRUSTSTORE_TYPE == 'PEM' %}
ssl.truststore.location={{ TRUSTSTORE_PATH }}/ca.cert
{% else %}
ssl.truststore.location={{ TRUSTSTORE_PATH }}/kafka.truststore.jks
ssl.truststore.password={{ TRUSTSTORE_PASS }}
{% endif %}
ssl.endpoint.identification.algorithm=
